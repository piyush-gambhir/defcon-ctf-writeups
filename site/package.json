{
  "name": "defcon-ctf-archive-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "npm run sync && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run sync && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vinext": "1.3.1",
    "vite": "8.3.5",
    "wrangler": "4.153.0",
    "typescript7": "npm:typescript@7.0.2"
  },
  "type": "module",
  "overrides": {
    "image-size": "2.0.4",
    "undici@>=7.0.0 <7.30.1": "7.30.1",
    "zod@>=4.0.0 <4.6.7": "4.6.7",
    "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
    "fflate@>=0.7.0 <0.7.5": "0.7.5"
  }
}
