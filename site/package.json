{
  "name": "defcon-ctf-archive-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "npm run sync && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run sync && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "typescript7": "npm:typescript@7.0.2",
    "vinext": "1.4.3",
    "vite": "8.3.6",
    "wrangler": "4.157.0"
  },
  "type": "module",
  "overrides": {
    "image-size": "2.0.4",
    "undici@>=7.0.0 <7.30.1": "7.30.1",
    "zod@>=4.0.0 <4.6.7": "4.6.7",
    "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
    "fflate@>=0.7.0 <0.7.5": "0.7.5",
    "minimatch@>=10.0.0 <11.0.1": "11.0.4"
  }
}
